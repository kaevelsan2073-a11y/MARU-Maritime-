---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Page not found">
  <PageHero eyebrow="404" title="Page not found" lead="The page you are looking for does not exist or has moved.">
    <div class="nf-actions">
      <a href="/" class="btn btn--gold">Back to home <Icon name="arrow" /></a>
      <a href="/contact/" class="btn btn--ghost">Contact us</a>
    </div>
  </PageHero>
</Base>

<style>
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }
</style>
