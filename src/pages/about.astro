---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Bridge from "../components/Bridge.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";
---

<Base title="About" description={site.description}>
  <PageHero eyebrow="About" title="About Maru Maritime" />

  <!-- Who we are -->
  <section class="section section--light">
    <div class="container about">
      <div class="about__text" data-reveal>
        <h2 class="h2">Who we are</h2>
        <p class="lead">{site.description}</p>
        <p class="lead">{site.relationships}</p>
      </div>
      <figure class="about__seal" data-reveal style="--delay:.1s">
        <img src="/brand/maru-seal-dark.png" alt="Maru Maritime seal: Anchored in Trust, Driven by Excellence" width="1000" height="1000" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- Relationships and presence -->
  <section class="section section--deep">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="h2">Relationships and presence</h2>
      </div>
      <div data-reveal style="--delay:.1s">
        <Bridge />
      </div>
    </div>
  </section>

  <!-- Tagline -->
  <section class="section section--dark divider-top tagline">
    <div class="container" data-reveal>
      <p class="tagline__text">Anchored in Trust. <span class="gold-text">Driven by Excellence.</span></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(40px, 7vw, 112px);
    align-items: center;
  }
  .about__text .h2 {
    margin-bottom: 28px;
  }
  .about__text .lead {
    color: var(--text-on-light);
  }
  .about__seal {
    margin: 0;
  }
  .about__seal img {
    width: 100%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 30px 60px rgba(6, 15, 30, 0.25);
  }
  .tagline {
    text-align: center;
  }
  .tagline__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(36px, 4.6vw, 60px);
    line-height: 1.15;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__seal {
      max-width: 320px;
    }
  }
</style>
