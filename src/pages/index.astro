---
import Base from "../layouts/Base.astro";
import Bridge from "../components/Bridge.astro";
import Lifecycle from "../components/Lifecycle.astro";
import RelationshipMap from "../components/RelationshipMap.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const principles = [
  {
    title: "Treat every ship as an investment",
    text: "Someone's capital is tied up in that hull. We look after its condition, its value and its reputation as carefully as its earnings.",
  },
  {
    title: "Run a tight operation",
    text: "Good voyages are planned properly, cost what they should and get paid on time. Small things, done every day, add up.",
  },
  {
    title: "Think in years, not fixtures",
    text: "Freight markets move in cycles. We make decisions with the owner's whole holding period in mind, not just the next charter.",
  },
];

const lifecycle = [
  ["Buy", "Finding the right vessel, inspecting it and negotiating the price."],
  ["Finance", "Setting up the ownership structure and the right level of debt."],
  ["Charter", "Securing employment that fits the market and the owner."],
  ["Operate", "Running voyages, overseeing technical management and controlling costs."],
  ["Report", "Regular numbers on earnings, costs and value, in plain language."],
  ["Sell", "Choosing the moment to exit, or renewing the fleet."],
];

---

<Base description={site.description}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <img class="hero__photo" src="/images/hero.jpg" alt="" fetchpriority="high" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__inner">
      <p class="hero__kicker" data-reveal>{site.label}</p>
      <h1 class="display" data-reveal style="--delay:.08s">End-to-end asset management across the life of the ship.</h1>
      <p class="lead" data-reveal style="--delay:.16s">{site.description}</p>
      <div class="hero__actions" data-reveal style="--delay:.24s">
        <a href="#what-we-do" class="btn btn--gold">What we do <Icon name="arrow" /></a>
        <a href="/contact/" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>

  <!-- ============ WHAT WE DO ============ -->
  <section class="section section--light" id="what-we-do">
    <div class="container wwd">
      <div class="wwd__text" data-reveal>
        <h2 class="h2">What we do</h2>
        <ol class="wwd__list">
          {site.services.map((s, i) => (
            <li>
              <a href={`/services/#${site.serviceIds[i]}`}>
                <span class="wwd__n">{String(i + 1).padStart(2, "0")}</span>
                <span class="wwd__name">{s}</span>
                <Icon name="arrow" class="wwd__arrow" />
              </a>
            </li>
          ))}
        </ol>
        <p class="wwd__note">Throughout the life cycle of the ship.</p>
        <a href="/services/" class="text-link">All services <Icon name="arrow" /></a>
      </div>
      <figure class="wwd__photo" data-reveal style="--delay:.1s">
        <img src="/images/detail.jpg" alt="Aerial view of a crude oil tanker underway" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ============ BRIDGING THE GAP ============ -->
  <section class="section section--deep">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="h2">Bridging the gap between seller, buyer, operator and charterer.</h2>
        <p class="lead">{site.relationships}</p>
      </div>
      <div class="gap-map" data-reveal style="--delay:.1s">
        <RelationshipMap />
      </div>
      <div class="gap-bridge" data-reveal style="--delay:.15s">
        <Bridge />
      </div>
    </div>
  </section>

  <!-- ============ LIFECYCLE ============ -->
  <section class="section section--light">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="h2">From purchase to sale.</h2>
        <p class="lead">
          Owners can hand us a single job or the whole lifecycle. Either way, it is one team, so nothing gets lost
          between hand-offs.
        </p>
      </div>
      <div data-reveal style="--delay:.1s">
        <Lifecycle stages={lifecycle as [string, string][]} />
      </div>
    </div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="section section--dark">
    <div class="container">
      <h2 class="h2 principles__title" data-reveal>What we hold ourselves to</h2>
      <div class="principles">
        {principles.map((p, i) => (
          <article data-reveal style={`--delay:${i * 0.08}s`}>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TAGLINE BAND ============ -->
  <section class="band">
    <img class="band__photo" src="/images/band.jpg" alt="" loading="lazy" />
    <div class="band__shade" aria-hidden="true"></div>
    <div class="container band__inner" data-reveal>
      <p class="band__quote">Anchored in Trust.<br />Driven by Excellence.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h) + 64px) 0 clamp(64px, 9vw, 120px);
    background: var(--navy-950);
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 55%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 15, 30, 0.92) 0%, rgba(6, 15, 30, 0.7) 40%, rgba(6, 15, 30, 0.12) 100%),
      linear-gradient(0deg, rgba(6, 15, 30, 0.8) 0%, rgba(6, 15, 30, 0) 40%);
  }
  .hero__inner {
    position: relative;
  }
  .hero__kicker {
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .hero h1 {
    max-width: 15ch;
  }
  .hero .lead {
    margin-top: 28px;
    color: #c9d1de;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  /* What we do */
  .wwd {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .wwd__list {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-light);
  }
  .wwd__list li {
    padding: 22px 0;
    border-bottom: 1px solid var(--line-light);
  }
  .wwd__n {
    font-size: 14px;
    font-weight: 600;
    color: var(--gold-600);
  }
  .wwd__name {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.2vw, 42px);
    line-height: 1.1;
  }
  .wwd__note {
    margin: 24px 0 0;
    color: var(--muted-on-light);
  }
  .wwd__photo {
    margin: 0;
  }
  .wwd__photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 30px 60px rgba(6, 15, 30, 0.18);
  }

  /* Principles */
  .principles__title {
    max-width: 18ch;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px);
  }
  .principles article {
    padding-top: 28px;
    border-top: 2px solid var(--gold-500);
  }
  .principles h3 {
    margin-bottom: 14px;
    font-size: 28px;
    font-weight: 600;
  }
  .principles p {
    margin: 0;
  }

  /* Bridging the gap */
  .gap-map {
    margin: 8px 0 clamp(48px, 6vw, 80px);
  }
  .gap-bridge {
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line-dark);
  }

  .wwd__list a {
    display: grid;
    grid-template-columns: 56px 1fr 24px;
    align-items: baseline;
    transition: padding 0.4s var(--ease), color 0.3s;
  }
  .wwd__list a:hover {
    padding-left: 10px;
    color: var(--gold-700);
  }
  .wwd__list :global(.wwd__arrow) {
    width: 20px;
    height: 20px;
    align-self: center;
    color: var(--gold-600);
  }
  .wwd__note + .text-link {
    margin-top: 18px;
  }

  /* Tagline band */
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(120px, 16vw, 220px);
    background: var(--navy-950);
  }
  .band__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 15, 30, 0.9), rgba(6, 15, 30, 0.45));
  }
  .band__inner {
    position: relative;
  }
  .band__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.08;
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
    }
    .wwd,
    .principles {
      grid-template-columns: 1fr;
    }

  }
</style>
