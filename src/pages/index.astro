---
import Base from "../layouts/Base.astro";
import Bridge from "../components/Bridge.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---

<Base description={site.description}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <img class="hero__photo" src="/images/hero.jpg" alt="" fetchpriority="high" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__inner">
      <p class="hero__kicker" data-reveal>{site.label}</p>
      <h1 class="display" data-reveal style="--delay:.08s">End-to-end asset management across the life of the ship.</h1>
      <p class="lead" data-reveal style="--delay:.16s">{site.description}</p>
      <div class="hero__actions" data-reveal style="--delay:.24s">
        <a href="#what-we-do" class="btn btn--gold">What we do <Icon name="arrow" /></a>
        <a href="/contact/" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>

  <!-- ============ WHAT WE DO ============ -->
  <section class="section section--light" id="what-we-do">
    <div class="container wwd">
      <div class="wwd__text" data-reveal>
        <h2 class="h2">What we do</h2>
        <ol class="wwd__list">
          {site.services.map((s, i) => (
            <li>
              <span class="wwd__n">{String(i + 1).padStart(2, "0")}</span>
              <span class="wwd__name">{s}</span>
            </li>
          ))}
        </ol>
        <p class="wwd__note">Throughout the life cycle of the ship.</p>
      </div>
      <figure class="wwd__photo" data-reveal style="--delay:.1s">
        <img src="/images/detail.jpg" alt="Deck cranes and accommodation block of a bulk carrier alongside" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ============ BRIDGING THE GAP ============ -->
  <section class="section section--deep">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="h2">Bridging the gap between seller, buyer, operator and charterer.</h2>
        <p class="lead">{site.relationships}</p>
      </div>
      <div data-reveal style="--delay:.1s">
        <Bridge />
      </div>
    </div>
  </section>

  <!-- ============ TAGLINE BAND ============ -->
  <section class="band">
    <img class="band__photo" src="/images/band.jpg" alt="" loading="lazy" />
    <div class="band__shade" aria-hidden="true"></div>
    <div class="container band__inner" data-reveal>
      <p class="band__quote">Anchored in Trust.<br />Driven by Excellence.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h) + 64px) 0 clamp(64px, 9vw, 120px);
    background: var(--navy-950);
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 15, 30, 0.94) 0%, rgba(6, 15, 30, 0.78) 42%, rgba(6, 15, 30, 0.25) 100%),
      linear-gradient(0deg, rgba(6, 15, 30, 0.85) 0%, rgba(6, 15, 30, 0) 45%);
  }
  .hero__inner {
    position: relative;
  }
  .hero__kicker {
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .hero h1 {
    max-width: 15ch;
  }
  .hero .lead {
    margin-top: 28px;
    color: #c9d1de;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  /* What we do */
  .wwd {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .wwd__list {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-light);
  }
  .wwd__list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-light);
  }
  .wwd__n {
    font-size: 14px;
    font-weight: 600;
    color: var(--gold-600);
  }
  .wwd__name {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.2vw, 42px);
    line-height: 1.1;
  }
  .wwd__note {
    margin: 24px 0 0;
    color: var(--muted-on-light);
  }
  .wwd__photo {
    margin: 0;
  }
  .wwd__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* Tagline band */
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(120px, 16vw, 220px);
    background: var(--navy-950);
  }
  .band__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 15, 30, 0.9), rgba(6, 15, 30, 0.45));
  }
  .band__inner {
    position: relative;
  }
  .band__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.08;
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
    }
    .wwd {
      grid-template-columns: 1fr;
    }
    .wwd__photo img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
