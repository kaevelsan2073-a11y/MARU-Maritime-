---
import Base from "../layouts/Base.astro";
import ShippingCycle from "../components/ShippingCycle.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const principles = [
  {
    title: "Treat every ship as an investment project",
    text: "Someone's capital is tied up in that hull. We oversee its condition and maintenance as carefully as its earnings.",
  },
  {
    title: "Run a tight ship",
    text: "Quality work and operations are planned, and in case of an unfortunate breakdown, we can make the judgment call that only comes with experience. Small things, done every day, add up.",
  },
  {
    title: "Think in years, not fixtures",
    text: "Freight markets move in cycles. We make decisions with the owner's whole holding period in mind, whether on spot or period time charter.",
  },
];

const cycle = [
  {
    name: "Recovery",
    market: "Rising market",
    stages: [
      "Uneconomic ships are scrapped",
      "Vessel supply and demand improve",
      "Cash flow increases",
      "Debt is paid down quickly",
    ],
  },
  {
    name: "Boom",
    market: "Rising market",
    stages: ["Ship values increase", "IPO markets open", "Bond markets open", "New ships are delivered"],
  },
  {
    name: "Decline",
    market: "Falling market",
    stages: ["Vessel supply exceeds demand", "The spot market weakens", "Ship values decline", "Some charterers default"],
  },
  {
    name: "Trough",
    market: "Falling market",
    stages: [
      "Debt is restructured",
      "Capital markets open: private equity and preferred",
      "Strong companies consolidate",
      "Investors order new ships",
    ],
  },
];

---

<Base description={site.description}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <img class="hero__photo" src="/images/hero.jpg" alt="" fetchpriority="high" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__inner">
      <h1 class="display" data-reveal style="--delay:.08s">End-to-end asset management across the life cycle of a ship</h1>
      <p class="lead" data-reveal style="--delay:.16s">{site.description}</p>
      <div class="hero__actions" data-reveal style="--delay:.24s">
        <a href="#what-we-do" class="btn btn--gold">What we do <Icon name="arrow" /></a>
        <a href="/contact/" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>

  <!-- ============ WHAT WE DO ============ -->
  <section class="section section--light" id="what-we-do">
    <div class="container wwd">
      <div class="wwd__text" data-reveal>
        <h2 class="h2">What we do</h2>
        <ol class="wwd__list">
          {site.services.map((s, i) => (
            <li>
              <a href={`/services/#${site.serviceIds[i]}`}>
                <span class="wwd__name">{s}</span>
                <Icon name="arrow" class="wwd__arrow" />
              </a>
            </li>
          ))}
        </ol>
        <a href="/services/" class="text-link">All services <Icon name="arrow" /></a>
      </div>
      <figure class="wwd__photo" data-reveal style="--delay:.1s">
        <img src="/images/detail.jpg" alt="Aerial view of a crude oil tanker underway" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ============ BRIDGING THE GAP ============ -->
  <section class="section section--deep">
    <div class="container gap">
      <h2 class="h2" data-reveal>Bridging the gap between owners, operators and charterers</h2>
      <div class="gap__body" data-reveal style="--delay:.1s">
        <p class="lead">{site.relationships}</p>
        <dl class="gap__facts">
          <div>
            <dt>Relationships</dt>
            <dd>{site.relationshipRegions.join(" · ")}</dd>
          </div>
          <div>
            <dt>Presence</dt>
            <dd>{site.presence}</dd>
          </div>
        </dl>
        <a href="/about/#relationships" class="text-link">See the map <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ============ SHIPPING CYCLE ============ -->
  <section class="section section--light">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <h2 class="h2">The shipping cycle</h2>
        <p class="lead">
          Freight and asset markets move in cycles. Where the market sits in the cycle shapes the right moment to
          buy, how to employ a ship and when to sell.
        </p>
      </div>
      <ShippingCycle phases={cycle} />
    </div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="section section--dark">
    <div class="container">
      <h2 class="h2 principles__title" data-reveal>What we hold ourselves to</h2>
      <div class="principles">
        {principles.map((p, i) => (
          <article data-reveal style={`--delay:${i * 0.08}s`}>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TAGLINE BAND ============ -->
  <section class="band">
    <img class="band__photo" src="/images/band.jpg" alt="" loading="lazy" />
    <div class="band__shade" aria-hidden="true"></div>
    <div class="container band__inner" data-reveal>
      <p class="band__quote">Anchored in Trust.<br />Driven by Excellence.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h) + 64px) 0 clamp(64px, 9vw, 120px);
    background: var(--navy-950);
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 55%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 15, 30, 0.92) 0%, rgba(6, 15, 30, 0.7) 40%, rgba(6, 15, 30, 0.12) 100%),
      linear-gradient(0deg, rgba(6, 15, 30, 0.8) 0%, rgba(6, 15, 30, 0) 40%);
  }
  .hero__inner {
    position: relative;
  }
  .hero__kicker {
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .hero h1 {
    max-width: 15ch;
  }
  .hero .lead {
    margin-top: 28px;
    color: #c9d1de;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  /* What we do */
  .wwd {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .wwd__list {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-light);
  }
  .wwd__list li {
    padding: 22px 0;
    border-bottom: 1px solid var(--line-light);
  }
  .wwd__name {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.2vw, 42px);
    line-height: 1.1;
  }
  .wwd__photo {
    margin: 0;
  }
  .wwd__photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 30px 60px rgba(6, 15, 30, 0.18);
  }

  /* Principles */
  .principles__title {
    max-width: 18ch;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px);
  }
  .principles article {
    padding-top: 28px;
    border-top: 2px solid var(--gold-500);
  }
  .principles h3 {
    margin-bottom: 14px;
    font-size: 28px;
    font-weight: 600;
  }
  .principles p {
    margin: 0;
  }

  /* Bridging the gap */
  .gap {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .gap__body .lead {
    margin: 0;
  }
  .gap__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin: 36px 0;
    padding-top: 28px;
    border-top: 1px solid var(--line-dark);
  }
  .gap__facts dt {
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-400);
  }
  .gap__facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 26px);
    line-height: 1.25;
  }

  .wwd__list a {
    display: grid;
    grid-template-columns: 1fr 24px;
    align-items: baseline;
    transition: padding 0.4s var(--ease), color 0.3s;
  }
  .wwd__list a:hover {
    padding-left: 10px;
    color: var(--gold-700);
  }
  .wwd__list :global(.wwd__arrow) {
    width: 20px;
    height: 20px;
    align-self: center;
    color: var(--gold-600);
  }
  .wwd__list + .text-link {
    margin-top: 28px;
  }

  /* Tagline band */
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(120px, 16vw, 220px);
    background: var(--navy-950);
  }
  .band__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 15, 30, 0.9), rgba(6, 15, 30, 0.45));
  }
  .band__inner {
    position: relative;
  }
  .band__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.08;
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
    }
    .wwd,
    .gap,
    .principles {
      grid-template-columns: 1fr;
    }

  }
</style>
