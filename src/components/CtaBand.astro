---
import Icon from "./Icon.astro";
interface Props {
  title?: string;
  text?: string;
  secondary?: { href: string; label: string };
}
const {
  secondary = { href: "/investors/", label: "Investors & partners" },
  title = "Have a ship, a cargo or a question?",
  text = "Whether you own tonnage, need a chartering partner or are looking at shipping as an investment, we would be glad to talk it through.",
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__inner" data-reveal>
    <img src="/brand/logo-emblem.svg" alt="" class="cta-band__mark" width="160" height="160" loading="lazy" />
    <div class="cta-band__text">
      
      <h2 class="h2">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href="/contact/" class="btn btn--gold">Contact us <Icon name="arrow" /></a>
      <a href={secondary.href} class="btn btn--ghost">{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 120px);
    background: linear-gradient(120deg, var(--navy-850), var(--navy-950));
    border-top: 1px solid var(--line-dark);
  }
  .cta-band__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px 64px;
  }
  .cta-band__mark {
    position: absolute;
    right: -40px;
    top: 50%;
    width: 420px;
    height: 420px;
    opacity: 0.06;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .cta-band__text .lead {
    margin-top: 20px;
    margin-bottom: 0;
  }
  .cta-band__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  @media (max-width: 960px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
