---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---
<section class="cta-band">
  <div class="container cta-band__inner" data-reveal>
    <img src="/brand/logo-emblem.svg" alt="" class="cta-band__mark" width="160" height="160" loading="lazy" />
    <div class="cta-band__text">
      <h2 class="h2">Contact us</h2>
      <p class="lead"><a href={`mailto:${site.email}`} class="cta-band__email">{site.email}</a></p>
    </div>
    <div class="cta-band__actions">
      <a href="/contact/" class="btn btn--gold">Contact us <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 120px);
    background: linear-gradient(120deg, var(--navy-850), var(--navy-950));
    border-top: 1px solid var(--line-dark);
  }
  .cta-band__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px 64px;
  }
  .cta-band__mark {
    position: absolute;
    right: -40px;
    top: 50%;
    width: 420px;
    height: 420px;
    opacity: 0.06;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .cta-band__text .lead {
    margin-top: 20px;
    margin-bottom: 0;
  }
  .cta-band__email {
    color: var(--gold-300);
    border-bottom: 1px solid var(--line-dark-strong);
  }
  .cta-band__email:hover {
    border-bottom-color: var(--gold-300);
  }
  .cta-band__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  @media (max-width: 960px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
