---
import ChartBackdrop from "./ChartBackdrop.astro";
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: string; // optional background photo, dimmed behind the title
  imagePosition?: string;
}
const { eyebrow, title, lead, image, imagePosition = "50% 50%" } = Astro.props;
---
<section class:list={["page-hero", { "page-hero--photo": image }]}>
  {image ? (
    <>
      <img class="page-hero__photo" src={image} alt="" style={`object-position:${imagePosition}`} />
      <div class="page-hero__shade" aria-hidden="true"></div>
    </>
  ) : (
    <ChartBackdrop cx={82} cy={30} />
  )}
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <span class="eyebrow" data-reveal>{eyebrow}</span>
    <h1 class="display" data-reveal style="--delay:.08s" set:html={title} />
    {lead && <p class="lead" data-reveal style="--delay:.16s">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(72px, 10vw, 136px)) 0 clamp(72px, 9vw, 120px);
    background: radial-gradient(120% 90% at 85% 0%, #12305a 0%, var(--navy-900) 45%, var(--navy-950) 100%);
    border-bottom: 1px solid var(--line-dark);
  }
  .page-hero__glow {
    position: absolute;
    right: -10%;
    top: -30%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(233, 200, 115, 0.1), transparent 60%);
    pointer-events: none;
  }
  .page-hero__inner {
    position: relative;
  }
  .page-hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 15, 30, 0.95) 0%, rgba(6, 15, 30, 0.82) 45%, rgba(6, 15, 30, 0.45) 100%),
      linear-gradient(0deg, rgba(6, 15, 30, 0.7) 0%, rgba(6, 15, 30, 0) 50%);
  }
  .page-hero--photo .page-hero__glow {
    display: none;
  }
  .page-hero h1 {
    max-width: 16ch;
  }
  .page-hero .lead {
    margin-top: 28px;
  }
</style>
